{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node"]
  },
  "include": ["apps/server/src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "packages/alarms"]
}

# Demo needs no credentials. Real mode requires PostgreSQL and Google OAuth.
APP_MODE=demo
PORT=3000
CLIENT_URL=http://localhost:8081
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aligned?schema=public
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/auth/callback
# Generate 32 random bytes, encoded as base64.
TOKEN_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_WEBHOOK_URL=
WHISPER_CLI=
WHISPER_MODEL=
# Native devices need the host's LAN address. Web uses localhost by default.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional during Vite migration only
LEGACY_CLIENT_URL=

# Production: NODE_ENV=production, APP_MODE=google; web/API share PUBLIC_URL.
# Leave EXPO_PUBLIC_API_URL empty for same-origin production web exports.
# Set it to the public HTTPS origin for EAS phone builds.
NODE_ENV=development
WEB_ROOT=
ENABLE_DIAGNOSTICS=false
EXPO_PUSH_ENABLED=false
# Optional enhanced Expo Push Service security; SERVER ONLY.
EXPO_ACCESS_TOKEN=
# Expo project UUID for native push registration; this is public, not a secret.
EXPO_PUBLIC_EAS_PROJECT_ID=
